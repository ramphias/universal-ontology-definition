# Studio environment variables.
# Copy to .env.local for local dev. In production set these in Netlify's
# Site Settings → Environment variables. Never commit .env.local.

# ─── GitHub OAuth (for NextAuth sign-in) ─────────────────────────────
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret

# ─── NextAuth ─────────────────────────────────────────────────────────
# Must be the SAME value as uod-backend's NEXTAUTH_SECRET — Studio mints
# JWS tokens here that the backend verifies with this shared secret.
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=replace-me-32-bytes-of-hex
NEXTAUTH_URL=http://localhost:3000

# ─── GitHub API for class-definition reads / PR creation ─────────────
GITHUB_REPO_OWNER=ramphias
GITHUB_REPO_NAME=universal-ontology-definition
# Server-side PAT for committing approved edits as a bot user
# (read scope only when reading public class JSON).
GITHUB_TOKEN=

# ─── Bootstrap admin ─────────────────────────────────────────────────
# Single GitHub login that gets the "admin" role on first sign-in,
# without needing an existing admin to grant it.
SUPER_ADMIN=ramphias

# ─── uod-backend (the FastAPI instance store, separate Fly.io service) ─
# Default is the public Fly deployment. Point at http://localhost:8000
# when running uod-backend locally.
BACKEND_URL=https://uod-backend.fly.dev
